<UserControl x:Class="ShoreHue.UI.Widgets.Notes.NoteWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ShoreHue.UI.Localization"
>
    <!-- 整块便签跟着当前便签颜色走（便笺/Keep：颜色是"这张便签纸"的属性，不是某个小标签的属性） -->
    <Grid x:Name="RootGrid" Focusable="True" KeyDown="Root_KeyDown" Background="{Binding ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ① 搜索 + 新建（成熟方案：便笺有便笺列表窗口、Keep 有搜索；笔记一多，没有搜索就没法用） -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     FontSize="12"
                     Height="26"
                     VerticalContentAlignment="Center"
                     Padding="6,0"
                     Background="#33FFFFFF"
                     BorderThickness="0"
                     Foreground="{Binding BodyForeground}"
                     TextChanged="Search_TextChanged"
                     ToolTip="{Binding Item[Note_SearchTip], Source={x:Static loc:LocalizationManager.Instance}}"/>
            <Button x:Name="BtnNewNote"
                    Grid.Column="1"
                    Content="＋"
                    Width="26" Height="26"
                    FontSize="14"
                    Margin="6,0,0,0"
                    Padding="0"
                    Background="#33FFFFFF"
                    Foreground="#1E1E1E"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="{Binding Item[Note_NewTip], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="NewNote_Click"/>
        </Grid>

        <!-- ② 便签芯片列表：显示**第一行**（= 标题），置顶的排在最前，带 📌 与 ✕
             ★ 事件一律挂在 ItemsControl 上（PreviewMouseDown/Up），**不能挂在 DataTemplate 里**：
               生成器是用 `root.FindName(...)` 挂事件的，而模板里的元素在**独立命名域**，
               FindName 永远找不到 → 处理器静默不挂（真机现象：芯片点不动、✕ 没反应）。
               委托方式：由外壳事件拿 OriginalSource，再沿可视树找回带 NoteItem 的 Border。 -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="96"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="NoteTabs" Background="Transparent"
                          PreviewMouseDown="Tabs_PreviewMouseDown"
                          PreviewMouseUp="Tabs_PreviewMouseUp">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- ★ 中性底色 + 左侧颜色点：颜色由便签纸承担，芯片只做"识别的锚点"，
                             用户选深色时也不会出现"深字压深底"看不清。 -->
                        <Border x:Name="TabBorder"
                                Background="#26FFFFFF"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,0,4,4"
                                Cursor="Hand"
                                ToolTip="{Binding Preview}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PinMark"
                                           Text="📌"
                                           FontSize="9"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           Visibility="Collapsed"/>
                                <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FirstLine}"
                                           FontSize="11"
                                           Foreground="#1E1E1E"
                                           MaxWidth="104"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Tag="close"：委托处理器靠它区分"关闭这张"与"切换到这张" -->
                                <Button Content="✕"
                                        Tag="close"
                                        Width="15" Height="15"
                                        FontSize="9"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Foreground="#666666"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="{Binding Item[Note_CloseTab], Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ③ 唯一的编辑区：**没有独立标题框** —— 标题就是第一行（便笺/Keep 的做法，
             顺带消掉了"标题与正文两套真相"那一整类 bug） -->
        <Grid Grid.Row="2" Margin="0,2,0,0">
            <TextBox x:Name="ContentEditor"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     FontSize="13"
                     MinHeight="60"
                     Foreground="{Binding BodyForeground}"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="Content_TextChanged"/>

            <TextBlock Text="{Binding Item[Note_EmptyHint], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="12"
                       Foreground="{Binding BodyForeground}"
                       Opacity="0.65"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding EmptyHintVisibility}"/>
        </Grid>
    </Grid>
</UserControl>
