<UserControl x:Class="ShoreHue.UI.Widgets.Calculator.CalculatorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid x:Name="RootGrid" Focusable="True" KeyDown="Root_KeyDown" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模式切换 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnStd" Content="{Binding Item[UI_CalculatorWidget_404], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource AccentButton}" Height="24" Padding="8,0" Click="ModeStd_Click"/>
            <Button x:Name="BtnSci" Content="{Binding Item[UI_CalculatorWidget_405], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="24" Padding="8,0" Margin="6,0,0,0" Click="ModeSci_Click"/>
            <Button x:Name="BtnProg" Content="{Binding Item[UI_CalculatorWidget_406], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="24" Padding="8,0" Margin="6,0,0,0" Click="ModeProg_Click"/>
            <TextBlock x:Name="RadixText" Text="" FontSize="10" Foreground="#2B88D8" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 显示区 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock x:Name="ExprText"
                           Text=""
                           FontSize="11"
                           Foreground="#8A8A8A"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DisplayText"
                           Text="0"
                           FontSize="26"
                           FontWeight="Light"
                           Foreground="#EEEEEE"
                           TextAlignment="Right"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 科学函数行 -->
        <WrapPanel x:Name="SciPanel" Grid.Row="2" Margin="0,0,0,6" Visibility="Collapsed">
            <Button Content="sin" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Click="SciFn_Click" Tag="sin"/>
            <Button Content="cos" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="cos"/>
            <Button Content="tan" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="tan"/>
            <Button Content="asin" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="asin"/>
            <Button Content="acos" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="acos"/>
            <Button Content="atan" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="atan"/>
            <Button Content="sinh" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="sinh"/>
            <Button Content="cosh" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="cosh"/>
            <Button Content="tanh" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="tanh"/>
            <Button Content="√" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="sqrt"/>
            <Button Content="x²" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="sqr"/>
            <Button Content="xʸ" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="Op_Click" Tag="pow"/>
            <Button Content="1/x" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="inv"/>
            <Button Content="n!" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="fact"/>
            <Button Content="π" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="pi"/>
            <Button Content="e" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="e"/>
            <Button Content="eˣ" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="exp"/>
            <Button Content="10ˣ" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="pow10"/>
            <Button Content="ln" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="ln"/>
            <Button Content="log" Style="{StaticResource FlatButton}" FontSize="11" Padding="6,2" Margin="3,0,0,0" Click="SciFn_Click" Tag="log"/>
            <Button x:Name="BtnDeg" Content="DEG" Style="{StaticResource FlatButton}" FontSize="10" Padding="6,2" Margin="3,0,0,0" Click="DegRad_Click" Tag="deg"/>
        </WrapPanel>

        <!-- 程序员位运算行 -->
        <StackPanel x:Name="ProgPanel" Grid.Row="2" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Content="HEX" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Click="Radix_Click" Tag="16"/>
                <Button Content="DEC" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="Radix_Click" Tag="10"/>
                <Button Content="OCT" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="Radix_Click" Tag="8"/>
                <Button Content="BIN" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="Radix_Click" Tag="2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Button Content="AND" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Click="BitOp_Click" Tag="&amp;"/>
                <Button Content="OR" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="BitOp_Click" Tag="|"/>
                <Button Content="XOR" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="BitOp_Click" Tag="^"/>
                <Button Content="NOT" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="BitNot_Click"/>
                <Button Content="&lt;&lt;" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="BitShift_Click" Tag="l"/>
                <Button Content="&gt;&gt;" Style="{StaticResource FlatButton}" FontSize="10" Padding="5,1" Margin="3,0,0,0" Click="BitShift_Click" Tag="r"/>
            </StackPanel>
        </StackPanel>

        <!-- 键盘 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="C" Style="{StaticResource FlatButton}" FontSize="15" Click="Clear_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="±" Style="{StaticResource FlatButton}" FontSize="15" Click="Negate_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Content="%" Style="{StaticResource FlatButton}" FontSize="15" Click="Percent_Click"/>
            <Button Grid.Row="0" Grid.Column="3" Content="÷" Style="{StaticResource FlatButton}" FontSize="15" Foreground="#2B88D8" Click="Op_Click" Tag="/"/>

            <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="7"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="8"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="9"/>
            <Button Grid.Row="1" Grid.Column="3" Content="×" Style="{StaticResource FlatButton}" FontSize="15" Foreground="#2B88D8" Click="Op_Click" Tag="*"/>

            <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="4"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="5"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="6"/>
            <Button Grid.Row="2" Grid.Column="3" Content="−" Style="{StaticResource FlatButton}" FontSize="15" Foreground="#2B88D8" Click="Op_Click" Tag="-"/>

            <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="1"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="2"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="3"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource FlatButton}" FontSize="15" Foreground="#2B88D8" Click="Op_Click" Tag="+"/>

            <Button Grid.Row="4" Grid.Column="0" Content="0" Style="{StaticResource FlatButton}" FontSize="16" Click="Digit_Click" Tag="0"/>
            <Button Grid.Row="4" Grid.Column="1" Content="." Style="{StaticResource FlatButton}" FontSize="16" Click="Dot_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content="⌫" Style="{StaticResource FlatButton}" FontSize="14" Click="Backspace_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource AccentButton}" FontSize="16" Click="Equals_Click"/>
        </Grid>
    </Grid>
</UserControl>
