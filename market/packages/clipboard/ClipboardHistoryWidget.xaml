<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ShoreHue.UI.Widgets.ClipboardHistory.ClipboardHistoryWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ★ 记忆库：搜索框 -->
        <Border Grid.Row="0" Background="#333333" CornerRadius="4" Margin="0,0,0,4">
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#EEEEEE" FontSize="11" Height="22"
                         VerticalContentAlignment="Center" Padding="4,0"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="{Binding Item[Clip_SearchPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="11" Foreground="#777777" Margin="6,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ★ 记忆库：分类过滤 -->
        <WrapPanel x:Name="FilterPanel" Grid.Row="1" Margin="0,0,0,4">
            <Button x:Name="btnFilterAll" Tag="All" Click="Filter_Click"
                    Content="{Binding Item[Clip_FilterAll], Source={x:Static loc:LocalizationManager.Instance}}"
                    Height="20" FontSize="10" Padding="6,0" Margin="0,0,4,3"
                    Background="#2D2D2D" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnFilterPinned" Tag="Pinned" Click="Filter_Click"
                    Content="{Binding Item[Clip_FilterPinned], Source={x:Static loc:LocalizationManager.Instance}}"
                    Height="20" FontSize="10" Padding="6,0" Margin="0,0,4,3"
                    Background="#2D2D2D" Foreground="#FFB300" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnFilterText" Tag="Text" Click="Filter_Click"
                    Content="{Binding Item[Clip_FilterText], Source={x:Static loc:LocalizationManager.Instance}}"
                    Height="20" FontSize="10" Padding="6,0" Margin="0,0,4,3"
                    Background="#2D2D2D" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnFilterLink" Tag="Link" Click="Filter_Click"
                    Content="{Binding Item[Clip_FilterLink], Source={x:Static loc:LocalizationManager.Instance}}"
                    Height="20" FontSize="10" Padding="6,0" Margin="0,0,4,3"
                    Background="#2D2D2D" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnFilterImage" Tag="Image" Click="Filter_Click"
                    Content="{Binding Item[Clip_FilterImage], Source={x:Static loc:LocalizationManager.Instance}}"
                    Height="20" FontSize="10" Padding="6,0" Margin="0,0,4,3"
                    Background="#2D2D2D" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnFilterFile" Tag="File" Click="Filter_Click"
                    Content="{Binding Item[Clip_FilterFile], Source={x:Static loc:LocalizationManager.Instance}}"
                    Height="20" FontSize="10" Padding="6,0" Margin="0,0,0,3"
                    Background="#2D2D2D" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"/>
        </WrapPanel>

        <!-- 列表（含收藏按钮） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="280">
            <ItemsControl x:Name="HistoryList" Background="Transparent"
                          PreviewMouseDown="List_PreviewMouseDown"
                          PreviewMouseUp="List_PreviewMouseUp"
                          KeyDown="List_KeyDown" Focusable="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent"
                                Padding="2,2"
                                Cursor="Hand"
                                ToolTip="{Binding SourceApp}"
                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>

                                <!-- ★ 收藏按钮（☆/★） -->
                                <Button Grid.Column="1"
                                        x:Name="PinBtn"
                                        Tag="pin"
                                        Width="18" Height="18"
                                        FontSize="11"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding Item[Clip_Pin], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="☆"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Content" Value="★"/>
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- ★ 长条目默认只显示「预览行数」行；鼠标悬停即展开全文、移开收回。
                                     三个坑都踩过了，别再改回去：
                                     ① 事件不能用 MouseEnter/MouseLeave —— 允许的事件集合就是
                                        XamlCodeGenerator.EventNames，里面没有它们（市场包会被沙箱直接拦下）。
                                     ② 收起高度**不能**写成元素上的 MaxHeight="..."：局部值优先级**高于**
                                        样式触发器，写在那里会让下面的 IsMouseOver 触发器永远不生效。
                                     ③ Style.Setter.Value **不支持 Binding**，所以收起高度走 DynamicResource
                                        （由代码后置按「预览行数」设置写入）。 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayText}"
                                           FontSize="12"
                                           Foreground="#EEEEEE"
                                           TextWrapping="Wrap"
                                           LineHeight="16"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="MaxHeight" Value="{DynamicResource ClipCollapsedHeight}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="MaxHeight" Value="Infinity"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 单条删除 -->
                                <Button Grid.Column="3"
                                        Content="✕"
                                        Width="18" Height="18"
                                        FontSize="10"
                                        Foreground="#888888"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Tag="del"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
