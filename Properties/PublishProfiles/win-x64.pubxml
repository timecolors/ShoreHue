<?xml version="1.0" encoding="utf-8"?>
<!--
  自包含单文件发布配置。
  用法：dotnet publish -c Release -p:PublishProfile=win-x64
  产物：bin\publish\win-x64\ShoreHue.exe（无需安装 .NET 运行时）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- ★ 让**托管程序集**也随单文件解压到临时目录（2026-09-26 实测加上的）：
         不开这个时，单文件运行中 Assembly.Location 返回空字符串、TRUSTED_PLATFORM_ASSEMBLIES
         也拿不到可用路径 —— 实测海床的 Roslyn 编译只拿到 **0 个程序集引用**，
         于是**所有插件（含 6 个内置小组件）都编译不了**：内置件静默回退 exe 内置实现，
         用户在海床里改文件、自己造面板全部无效（"文件夹即真相源"在发布版上彻底失效）。
         另外它还会让 dotnet publish 报 IL3000（Assembly.Location 在单文件下恒为空）而**直接失败**。
         开启后引用恢复正常（实测 251 个）。 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
