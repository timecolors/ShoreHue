<UserControl x:Class="ShoreHue.UI.Panels.TaskbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl"
             Background="Transparent" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">

    <UserControl.Resources>
        <DataTemplate x:Key="ShortcutTemplate">
            <Border Background="Transparent" 
                    Cursor="Hand"
                    Margin="2"
                    Padding="4"
                    VerticalAlignment="Stretch"
                    Tag="{Binding}">
                <Image Source="{Binding Icon}" 
                       Width="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                       Height="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WindowTemplate">
            <Border Background="Transparent" 
                    Cursor="Hand"
                    Margin="2"
                    Padding="6,2"
                    VerticalAlignment="Stretch">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Column="0" 
                           Grid.Row="0"
                           Source="{Binding Icon}" 
                           Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Grid.Row="0"
                               Text="{Binding DisplayName}" 
                               FontSize="12" 
                               Foreground="#EEEEEE"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               MaxWidth="120"/>

                    <Button Grid.Column="2" 
                            Grid.Row="0"
                            Width="18" Height="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            PreviewMouseUp="CloseBtn_PreviewMouseUp"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{Binding Item[UI_TaskbarView_133], Source={x:Static loc:LocalizationManager.Instance}}">
                        <Path Style="{StaticResource LineIcon}"
                              Data="{StaticResource IconClose}"
                              Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- ★ 分组标签：组内图标拼版（2×2）；鼠标放上展开成员、移走收起；右键解散 -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Background="#14FFFFFF"
                    CornerRadius="6"
                    Cursor="Hand"
                    Margin="2"
                    Padding="4"
                    VerticalAlignment="Stretch"
                    MouseEnter="Group_MouseEnter"
                    MouseLeave="Group_MouseLeave"
                    MouseRightButtonUp="Group_RightClick"
                    ToolTip="{Binding DisplayName}">
                <Grid Width="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                      Height="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}">
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Margin="1"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 成员数角标：一眼看出这是分组（图标为空时也认得出来） -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#CC000000" CornerRadius="6" Padding="3,0" Margin="0,0,-4,-4"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding WindowCount}" FontSize="9" Foreground="#EEEEEE"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="MainGrid" AllowDrop="True" />
</UserControl>
