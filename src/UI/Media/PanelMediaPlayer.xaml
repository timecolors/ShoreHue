<UserControl x:Class="ShoreHue.UI.Media.PanelMediaPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:ShoreHue.UI.Media" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 画面区 -->
        <Grid Grid.Row="0"
              x:Name="VideoArea"
              Background="#1A1A1A"
              ClipToBounds="True"
              MouseWheel="VideoArea_MouseWheel"
              PreviewMouseRightButtonDown="VideoArea_PreviewMouseRightButtonDown"
              PreviewMouseRightButtonUp="VideoArea_PreviewMouseRightButtonUp"
              MouseLeftButtonDown="VideoArea_MouseLeftButtonDown"
              MouseLeftButtonUp="VideoArea_MouseLeftButtonUp"
              MouseMove="VideoArea_MouseMove">

            <!-- 截图镜像回退（PrintWindow 抓帧） -->
            <Image x:Name="MirrorImage"
                   Stretch="Uniform"
                   RenderTransformOrigin="0.5,0.5"
                   Visibility="Collapsed">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="MirrorZoom" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>

            <!-- 窗口嵌入宿主（第二块显示屏）：真实窗口直接放进来 -->
            <media:WindowEmbedHost x:Name="EmbedHost"
                                   Visibility="Collapsed"/>

            <TextBlock x:Name="PlaceholderText"
                       Text="{Binding Item[UI_PanelMediaPlayer_50], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="11"
                       Foreground="#777777"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       LineHeight="18"/>

            <!-- 镜像异常提示（最小化/窗口已关闭），只在需要时显示 -->
            <Border x:Name="MirrorStatusBar"
                    Background="#B3202020"
                    CornerRadius="8"
                    Padding="8,3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,6,0,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="MirrorStatusBar_MouseLeftButtonUp"
                    Visibility="Collapsed">
                <TextBlock x:Name="MirrorStatusText"
                           Text="{Binding Item[UI_PanelMediaPlayer_51], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="10"
                           Foreground="#DDDDDD"/>
            </Border>
        </Grid>

        <!-- 控制区 -->
        <Border Grid.Row="1" Background="#1E1E1E" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnMirrorPick"
                        Content="{Binding Item[Pip_MirrorShort], Source={x:Static loc:LocalizationManager.Instance}}"
                        Style="{StaticResource IconButton}"
                        Click="MirrorPick_Click"
                        ToolTip="{Binding Item[UI_PanelMediaPlayer_52], Source={x:Static loc:LocalizationManager.Instance}}"/>
                <Button x:Name="BtnEmbedPick"
                        Content="{Binding Item[Pip_EmbedShort], Source={x:Static loc:LocalizationManager.Instance}}"
                        Style="{StaticResource IconButton}"
                        Margin="4,0,0,0"
                        Click="EmbedPick_Click"
                        ToolTip="{Binding Item[UI_PanelMediaPlayer_53], Source={x:Static loc:LocalizationManager.Instance}}"/>
                <Button x:Name="BtnStop"
                        Style="{StaticResource IconButton}"
                        Margin="4,0,0,0"
                        Click="Stop_Click"
                        ToolTip="{Binding Item[UI_PanelMediaPlayer_54], Source={x:Static loc:LocalizationManager.Instance}}">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconStop}"/>
                </Button>
                <TextBlock x:Name="MirrorTitleText"
                           Text=""
                           FontSize="10"
                           Foreground="#8A8A8A"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
