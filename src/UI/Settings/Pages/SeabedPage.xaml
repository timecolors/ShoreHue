<UserControl x:Class="ShoreHue.UI.Settings.Pages.SeabedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="140" MaxWidth="420"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：配置树（一级/二级/三级，每级可 ⊕ 新增） -->
        <Border Background="{DynamicResource SettingsCardBg}" CornerRadius="8" Padding="6">
            <DockPanel>
                <!-- ★ 按名字筛选（清空即恢复目录树）：命中的项全深度列出并显示相对路径 -->
                <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#888888"/>
                    <TextBox Grid.Column="1" x:Name="txtTreeFilter"
                             FontSize="12" BorderThickness="0" Background="Transparent"
                             ToolTip="按名字筛选文件/文件夹（全深度匹配，显示相对路径；清空即恢复目录树）"
                             TextChanged="Tree_Filter_TextChanged"/>
                </Grid>
                <ListBox x:Name="lstConfigTree"
                         SelectionChanged="LstConfigTree_SelectionChanged"
                         SelectionMode="Extended"
                         AllowDrop="True"
                         DragOver="Tree_DragOver"
                         Drop="Tree_Drop"
                         KeyDown="Tree_KeyDown"
                         FontSize="12"
                         BorderThickness="0"
                         Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ContextMenu>
                                <!-- ★ 文件资源管理器右键（VS Code 语义）：新建文件/新建文件夹/重命名/删除/打开 -->
                                <ContextMenu>
                                    <MenuItem Header="新建文件…" Click="Fs_NewFile_Click"/>
                                    <MenuItem Header="新建文件夹…" Click="Fs_NewFolder_Click"/>
                                    <Separator/>
                                    <MenuItem Header="重命名…" Click="Fs_Rename_Click"/>
                                    <MenuItem Header="删除" Click="Fs_Delete_Click"/>
                                    <MenuItem Header="在资源管理器中打开" Click="Fs_OpenDir_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <!-- 占位行的 ⊕：在缩进位置（跟随层级），创建同级新功能 -->
                                <Button Content="⊕"
                                        Width="18" Height="18"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="#4A90D9"
                                        FontSize="13"
                                        Margin="{Binding IndentMargin}"
                                        Click="BtnAddNode_Click"
                                        ToolTip="创建同级新功能">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{Binding IndentMargin}" Foreground="{Binding TextBrush}" TextDecorations="{Binding TextDecor}"/>
                            </StackPanel>
                            <!-- 用户新建项：行末 ✕ 删除整个项 -->
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="20" Height="20"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="#E06060"
                                    FontSize="12"
                                    Click="BtnDeleteNode_Click"
                                    ToolTip="删除此新建项">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDelete}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 可拖动分隔条：调整左侧宽度 -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- 右侧：编程框 -->
        <Grid Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtNodeTitle" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtNodeHint" FontSize="10.5" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBox x:Name="txtJsonEditor"
                     Grid.Row="1"
                     FontFamily="Consolas"
                     Background="{DynamicResource SettingsCardBg}"
                     Foreground="{DynamicResource SettingsWindowFg}"
                     FontSize="12"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="8"
                     Margin="0,8,0,0"/>
            <!-- ★ 完全编程模式：Tab 切换 .xaml/.xaml.cs 编辑器 + 底部实时预览（不挤占横向空间） -->
            <Grid x:Name="xamlEditorPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.45*"/>
                </Grid.RowDefinitions>

                <!-- 编辑器（上）：Tab 切换 .xaml / .xaml.cs -->
                <TabControl x:Name="xamlTab" Grid.Row="0" Background="Transparent" BorderThickness="0">
                    <TabItem Header=".xaml（界面）">
                        <TextBox x:Name="txtXamlEditor"
                                 FontFamily="Consolas"
                                 Background="{DynamicResource SettingsCardBg}"
                                 Foreground="{DynamicResource SettingsWindowFg}"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="8"/>
                    </TabItem>
                    <TabItem Header=".xaml.cs（代码后置）">
                        <TextBox x:Name="txtXamlCsEditor"
                                 FontFamily="Consolas"
                                 Background="{DynamicResource SettingsCardBg}"
                                 Foreground="{DynamicResource SettingsWindowFg}"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="8"/>
                    </TabItem>
                </TabControl>

                <!-- 分隔条 -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" Cursor="SizeNS" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                <!-- 预览（下）：实时渲染 .xaml -->
                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="txtPreviewLabel" DockPanel.Dock="Top" Text="预览（实时渲染 .xaml）" FontSize="10.5" Foreground="#888888" Margin="0,0,0,2"/>
                    <Border x:Name="previewFrame" Background="{DynamicResource SettingsCardBg}" CornerRadius="6" Padding="8"
                            BorderBrush="#33333333" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ContentControl x:Name="xamlPreviewHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="btnCompile" Content="编译" Style="{StaticResource Win11Button}" Height="28" Padding="16,0" Click="BtnCompile_Click" ToolTip="校验当前编辑内容（不写盘）"/>
                <Button x:Name="btnSaveFile" Content="保存文件" Style="{StaticResource Win11Button}" Height="28" Padding="16,0" Margin="8,0,0,0" Click="BtnSaveFile_Click" ToolTip="把编辑器内容写回选中的真实文件（文件夹=真相，VS Code 语义）"/>
                <Button x:Name="btnRestore" Content="恢复" Style="{StaticResource Win11Button}" Height="28" Padding="16,0" Margin="8,0,0,0" Click="BtnRestore_Click"/>
                <ComboBox x:Name="cmbProgMode" Width="110" Height="28" FontSize="11" VerticalAlignment="Center"
                          ToolTip="编程模式：简单编程=纯 C# 代码；完全编程=XAML 界面 + 代码后置（两文件）"
                          SelectionChanged="CmbProgMode_SelectionChanged">
                    <ComboBoxItem Content="简单编程" Tag="Simple"/>
                    <ComboBoxItem x:Name="cmbProgXamlItem" Content="完全编程" Tag="Xaml"/>
                </ComboBox>
                <Button x:Name="btnCopyPrompt" Content="复制 AI 提示词" Style="{StaticResource Win11Button}" Height="28" Padding="16,0" Margin="8,0,0,0" Click="BtnCopyPrompt_Click"/>
                  <Button x:Name="btnOpenNodeFolder" Content="打开文件夹" Style="{StaticResource Win11Button}" Height="28" Padding="16,0" Margin="8,0,0,0" Click="BtnOpenNodeFolder_Click" ToolTip="在系统文件管理器中打开当前选中功能的文件夹"/>
                  <Button x:Name="btnAiGuide" Content="AI 编程指南" Style="{StaticResource Win11Button}" Height="28" Padding="16,0" Margin="8,0,0,0" Click="BtnAiGuide_Click" ToolTip="打开 AI 编程指南：能做什么/不能做什么/各类功能教程"/>
            </StackPanel>

            <!-- ★ 状态行单独占一行：以前它排在那一排按钮的**末尾**，而 StackPanel 不换行 ——
                 按钮越加越多之后（复制提示词/打开文件夹/AI 编程指南），"编译通过"这类提示
                 直接**被挤出右边界裁掉**，用户以为提示没了。状态信息必须有自己的位置。
                 ★ 空文本时折叠：实测空 TextBlock 仍占 13.97px 行高（不是 0），白占编辑框高度。
                 纯 XAML 的 DataTrigger 解决，不需要事件/代码（TextBlock 没有 TextChanged）。 -->
            <TextBlock x:Name="txtJsonStatus" Grid.Row="3" Margin="0,6,0,0" FontSize="11" Foreground="#666666" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 预设区（整套/局部保存、切换、删除） -->
            <Border Grid.Row="4" Background="{DynamicResource SettingsCardBg}" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="预设（可保存整套，也可保存单个预设）" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnOtherSeabed" Content="看看其他海床" Style="{StaticResource Win11Button}" Height="26" FontSize="11" Click="BtnOtherSeabed_Click"/>
                    </Grid>
                    <TextBlock Text="「其他海床」共享平台：导出当前预设为 .shpkg 包分享（自动标注权限），导入他人包时提示风险权限。" FontSize="10.5" Foreground="#999999" Margin="0,2,0,6" TextWrapping="Wrap"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnSaveFull" Content="保存整套" Style="{StaticResource Win11Button}" Height="28" Click="BtnSaveFull_Click" ToolTip="整套预设：保存全部配置，需命名"/>
                        <Button Grid.Column="1" x:Name="btnSavePartial" Content="保存当前预设" Style="{StaticResource Win11Button}" Height="28" Margin="8,0,0,0" Click="BtnSavePartial_Click" ToolTip="单预设：以当前选中节点命名保存，可应用并标记冲突"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbPresets" FontSize="12" Height="28" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnApplyPreset" Content="应用预设" Style="{StaticResource Win11Button}" Height="28" Margin="8,0,0,0" Click="BtnApplyPreset_Click"/>
                        <Button Grid.Column="2" x:Name="btnDeletePreset" Content="删除预设" Style="{StaticResource Win11Button}" Height="28" Margin="8,0,0,0" Click="BtnDeletePreset_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
