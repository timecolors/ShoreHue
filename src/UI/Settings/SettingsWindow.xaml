<Window x:Class="ShoreHue.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShoreHue.UI.Settings"
        xmlns:pages="clr-namespace:ShoreHue.UI.Settings.Pages"
        Title="{Binding Item[UI_SettingsWindow_134], Source={x:Static loc:LocalizationManager.Instance}}"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource CoastFlat}"
        Foreground="{DynamicResource SettingsWindowFg}"
        MinHeight="560" MinWidth="780" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">

    <Window.Resources>
        <Style x:Key="InfoTipStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ★ 主题资源（浅色默认；运行时按系统主题切换深色变体） -->
        <!-- 窗口背景：海岸线主题静态渐变（右上沙滩 → 左下海，浅/深由代码随系统主题切换） -->
        <LinearGradientBrush x:Key="CoastFlat" StartPoint="1,0" EndPoint="0,1">
            <GradientStop Color="#FBF3DF" Offset="0.00"/>
            <GradientStop Color="#F2E7CA" Offset="0.35"/>
            <GradientStop Color="#DCE9E6" Offset="0.62"/>
            <GradientStop Color="#C2DCE6" Offset="0.82"/>
            <GradientStop Color="#B4D3E0" Offset="1.00"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SettingsWindowBg" Color="#F9F9F9"/>
        <SolidColorBrush x:Key="SettingsWindowFg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SettingsCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsBorder" Color="#D0D0D0"/>

        <!-- ★ Win11 浅色下拉框（覆盖全局深色样式，适配浅色设置窗口） -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsWindowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path x:Name="arrow"
                                  Data="M 0,0 L 3.5,3.5 L 7,0"
                                  Stroke="#666666"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False">
                                <Border Background="{DynamicResource SettingsCardBg}"
                                        BorderBrush="{DynamicResource SettingsBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MaxHeight="280">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource SettingsWindowFg}"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E5F1FB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoTipButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="ⓘ"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Win11 浅色标签页 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsWindowFg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="14,6"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsCardBg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Item[UI_SettingsWindow_135], Source={x:Static loc:LocalizationManager.Instance}}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="#DDDDDD"
                    FontSize="12.5">

            <!-- ====== 选项卡1：通用设置 ====== -->
            <!-- ====== 选项卡1：常规设置（应用级） ====== -->
            <TabItem x:Name="tabGeneral" Header="{Binding Item[UI_SettingsWindow_278], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- ========== 分组：语言 ========== -->
                        <Border Background="{DynamicResource SettingsCardBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_279], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource InfoTipStyle}"
                                               HorizontalAlignment="Right"
                                               ToolTip="{Binding Item[UI_SettingsWindow_280], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_281], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12" Width="60"/>
                                    <ComboBox Grid.Column="1" x:Name="cmbLanguage" Width="180" FontSize="12"
                                              HorizontalAlignment="Left" Height="28" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_282], Source={x:Static loc:LocalizationManager.Instance}}" Tag=""/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_283], Source={x:Static loc:LocalizationManager.Instance}}" Tag="zh-CN"/>
                                        <ComboBoxItem Content="English" Tag="en-US"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="txtCurrentLanguage" Text="" FontSize="10.5" Foreground="#888888" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组：编程模式（海床） ========== -->
                        <Border Background="{DynamicResource SettingsCardBg}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="编程模式（海床）" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock Text="开启后，设置支持以代码（JSON）编辑：每个功能可生成 AI 提示词、复制原面板为副本自由改造、将整套或局部配置保存为预设。勾选后将在设置中新增「海床」页签。"
                                           FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <CheckBox x:Name="chkProgrammingMode"
                                          Content="启用编程模式（海床）"
                                          FontSize="12"
                                          Checked="ChkProgrammingMode_Changed"
                                          Unchecked="ChkProgrammingMode_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组：自动更新（商店版隐藏） ========== -->
                        <Border x:Name="UpdateGroup"
                                Background="{DynamicResource SettingsCardBg}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Item[UI_SettingsWindow_294], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource InfoTipStyle}"
                                               HorizontalAlignment="Right"
                                               ToolTip="{Binding Item[UI_SettingsWindow_295], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkAutoCheckUpdate"
                                              Content="{Binding Item[UI_SettingsWindow_296], Source={x:Static loc:LocalizationManager.Instance}}"
                                              VerticalAlignment="Center"
                                              FontSize="12"/>
                                    <Button Grid.Column="1" x:Name="btnCheckUpdate"
                                            Content="{Binding Item[UI_SettingsWindow_297], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Style="{StaticResource Win11Button}"
                                            Width="90" Height="28"
                                            Click="BtnCheckUpdate_Click"/>
                                </Grid>

                                <TextBlock x:Name="txtUpdateStatus"
                                           Text="{Binding Item[UI_SettingsWindow_298], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Margin="0,4,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="从 GitHub 版卸载："
                                               FontSize="11"
                                               Foreground="#888888"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="btnUninstall"
                                            Content="{Binding Item[UI_SettingsWindow_396], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Style="{StaticResource Win11Button}"
                                            Height="28"
                                            Click="BtnUninstall_Click"
                                            ToolTip="{Binding Item[UI_SettingsWindow_397], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组：面板运行帧率 ========== -->
                        <Border Background="{DynamicResource SettingsCardBg}"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Item[Set_PanelFrameRate], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource InfoTipStyle}"
                                               HorizontalAlignment="Right"
                                               ToolTip="{Binding Item[Set_PanelFrameRateTip], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Item[Set_PanelFrameRateLabel], Source={x:Static loc:LocalizationManager.Instance}}"
                                               VerticalAlignment="Center" FontSize="12" Width="60"/>
                                    <!-- ★ 修复：Minimum=0 使"0=自动满帧"档可选；原 Minimum=30 会把 Value=0 钳到 30 -->
                                    <Slider Grid.Column="1" x:Name="sldPanelFrameRate"
                                            Minimum="0" Maximum="120" Value="0"
                                            TickFrequency="30" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" x:Name="txtPanelFrameRate"
                                               Text="自动" TextAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="{Binding Item[Set_PanelFrameRateSliderTip], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Item[Set_PanelFrameRateHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="10.5" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组：关于与隐私 ========== -->
                        <Border Background="{DynamicResource SettingsCardBg}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="txtAbout"
                                           Text="{Binding Item[UI_SettingsWindow_299], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Item[UI_SettingsWindow_300], Source={x:Static loc:LocalizationManager.Instance}}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Item[UI_SettingsWindow_301], Source={x:Static loc:LocalizationManager.Instance}}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 选项卡2：区域设置（哪里显示什么 + 触发） ====== -->
            <TabItem x:Name="tabRegion" Header="{Binding Item[Set_Tab_Region], Source={x:Static loc:LocalizationManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Item[Set_Sec_EdgeTrigger], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SettingsWindowFg}" Margin="0,12,0,6"/>
                        <!-- ========== 分组2：触发与位置 ========== -->
                        <Border Background="{DynamicResource SettingsCardBg}"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Item[UI_SettingsWindow_144], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="chkTop" Content="{Binding Item[UI_SettingsWindow_145], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkBottom" Content="{Binding Item[UI_SettingsWindow_146], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkLeft" Content="{Binding Item[UI_SettingsWindow_147], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkRight" Content="{Binding Item[UI_SettingsWindow_148], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <TextBlock Style="{StaticResource InfoTipStyle}"
                                               ToolTip="{Binding Item[UI_SettingsWindow_149], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="chkTopLeft" Content="{Binding Item[UI_SettingsWindow_150], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkTopRight" Content="{Binding Item[UI_SettingsWindow_151], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkBottomLeft" Content="{Binding Item[UI_SettingsWindow_152], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkBottomRight" Content="{Binding Item[UI_SettingsWindow_153], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,12,3"/>
                                    <TextBlock Style="{StaticResource InfoTipStyle}"
                                               ToolTip="{Binding Item[UI_SettingsWindow_154], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_155], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item[UI_SettingsWindow_156], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Item[UI_SettingsWindow_157], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_158], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbTopMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_159], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_160], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Item[UI_SettingsWindow_161], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbFixedShapeTop" Width="90" FontSize="12">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_162], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_163], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_164], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="{Binding Item[UI_SettingsWindow_165], Source={x:Static loc:LocalizationManager.Instance}}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_166], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbBottomMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_167], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_168], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Item[UI_SettingsWindow_169], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cmbFixedShapeBottom" Width="90" FontSize="12">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_170], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_171], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_172], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_173], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbLeftMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_174], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_175], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Item[UI_SettingsWindow_176], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cmbFixedShapeLeft" Width="90" FontSize="12">
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_177], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_178], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <ComboBoxItem Content="{Binding Item[UI_SettingsWindow_179], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="{Binding Item[UI_SettingsWindow_180], Source={x:Static loc:LocalizationManager.Instance}}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Item[UI_SettingsWindow_181], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontSize="12"/>
